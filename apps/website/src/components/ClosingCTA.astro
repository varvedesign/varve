---
/**
 * ClosingCTA — reusable closing call-to-action section.
 *
 * Consistent across all pages: centered editorial heading with accent word,
 * supporting text, and download/secondary action. Uses the shared .closing-cta
 * styles from global.css.
 */
import Button from './Button.astro';
import DownloadCTA from './DownloadCTA.astro';
import Reveal from './Reveal.astro';
import { sitePath } from '../lib/siteUrl';

interface Props {
  title?: string;
  accentWord?: string;
  text?: string;
  showDownload?: boolean;
  /** Off by default: only the home page has an allowlisted /try campaign ref. */
  showTryBrowser?: boolean;
  /** First-party `ref` tag, e.g. `home-closing`. Required when showTryBrowser is on. */
  tryRef?: string;
}

const {
  title = 'Start designing',
  accentWord = 'locally.',
  text = 'Free and source-available under FSL-1.1-MIT. Core editing is local-first, with optional network features under your control.',
  showDownload = true,
  showTryBrowser = false,
  tryRef,
} = Astro.props;
---

<section class="closing-cta" aria-labelledby="closing-cta-title">
  <div class="container-custom closing-cta-inner">
    <Reveal as="div">
      <p class="section-eyebrow">Get started</p>
      <h2 id="closing-cta-title" class="closing-cta-title">
        {title}{' '}<span class="closing-cta-accent">{accentWord}</span>
      </h2>
      <p class="closing-cta-text">{text}</p>
      <div class="closing-cta-actions">
        {showDownload && <DownloadCTA size="large" beta />}
        {showTryBrowser && tryRef && (
          <Button
            variant="secondary"
            href={sitePath(`/try/?ref=${tryRef}`)}
            data-analytics-demo-launch
          >
            Try it in your browser
          </Button>
        )}
      </div>
    </Reveal>
  </div>
</section>
