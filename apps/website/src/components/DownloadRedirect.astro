---
import Button from './Button.astro';

interface Props {
  heading: string;
  dest: string;
  destLabel: string;
}

const { heading, dest, destLabel } = Astro.props;
---

<div class="redirect-page">
  <h1>{heading}</h1>
  <p>
    Installers live on the <a href={dest}>{destLabel}</a>.
  </p>
  <p>
    <Button variant="secondary" href={dest}>
      Go to the download page
    </Button>
  </p>
</div>

<script is:inline define:vars={{ dest }}>
  window.location.replace(dest);
</script>

<style>
  .redirect-page {
    max-width: 600px;
    margin-block: 0;
    margin-inline: auto;
    padding-block: clamp(var(--space-9), 10vh, var(--space-11));
    padding-inline: 0;
    text-align: center;
  }

  .redirect-page h1 {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-5);
    color: var(--text-primary);
  }

  .redirect-page p {
    font-size: var(--type-content-body-size);
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
  }
</style>
