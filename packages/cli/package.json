{
  "name": "@varve/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Headless Varve tooling: canonicalize, validate, semantic diff, three-way merge driver, and review bundles (M13 + M14).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "varve": "./bin/varve.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/cli",
    "build:bundle": "node scripts/build-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@varve/automation": "workspace:*",
    "@varve/history": "workspace:*",
    "@varve/scene": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "^0.28.2"
  },
  "license": "FSL-1.1-MIT",
  "files": [
    "bin",
    "dist",
    "src"
  ]
}
