    "decorative",
    "unfinished"
  ],
  "commands": {
    "varve.document.info": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["a document session is open"],
      "tests": ["packages/automation/src/__tests__/live.test.ts"],
      "uiSurfaces": [
        "documentInfo",
        "auditDocument",
        "auditPage",
        "auditSelection",
        "runAudit",
        "inspectMode"
      ]
    },
    "varve.document.save": {
      "status": "implemented",
      "gesture": [],
      "preconditions": [
        "a document session is open",
        "a file gateway is attached (varve serve / varve mcp)"
      ],
      "tests": ["packages/cli/src/__tests__/control-mcp.subprocess.test.ts"],
      "limits": [
        "Not available under `varve exec`/`varve batch`, which attach no external handler; those write results with --in-place/--out instead.",
        "No connected runtime yet, so the desktop app cannot be asked to save through this command."
      ],
      "uiSurfaces": ["save"]
    },
    "varve.node.list": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["a document session is open"],
      "tests": ["packages/automation/src/__tests__/executor.test.ts"],
      "uiSurfaces": ["openDocumentPanel"]
    },
    "varve.node.get": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["a document session is open"],
      "tests": ["packages/automation/src/__tests__/executor.test.ts"],
      "uiSurfaces": ["openInspectorProperties", "openInspectPanel"]
    },
    "varve.node.find": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["a document session is open"],
      "tests": ["packages/automation/src/__tests__/executor.test.ts"],
      "limits": ["Reports ambiguity; it never coerces a name into an id."],
      "uiSurfaces": ["findReplace", "detectDuplicates", "selectAllWithSameFont"]
    },
    "varve.node.create": {
      "status": "implemented",
      "gesture": ["drag-to-create", "click-to-place"],
      "preconditions": [
        "a document session is open",
        "the target parent is a frame or group, and is not locked"
      ],
      "tests": [
        "packages/automation/src/__tests__/live.test.ts",
        "packages/automation/src/__tests__/executor.test.ts"
      ],
      "limits": [
        "Creates rect, ellipse, frame and text only. group, table, adjustment, path and raster nodes are read-only through the catalog.",
        "Cannot reproduce a drag-to-create gesture's intermediate samples; only the committed result."
      ],
      "uiSurfaces": ["toolRect", "toolEllipse", "toolFrame", "toolText", "insertIcon"]
    },
    "varve.node.set": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["every named node exists and none is locked"],
      "tests": ["packages/automation/src/__tests__/live.test.ts"],
      "limits": [
        "Typed properties only (name, visible, locked, opacity, rotation, blendMode, fill, text, fontSize). No arbitrary property path.",
        "Writes a static opacity; the editor's own setter also feeds motion auto-keyframing while a timeline plays.",
        "Nodes with stacked fills reject a single `fill` rather than silently changing nothing."
      ],
      "uiSurfaces": [
        "openInspectorProperties",
        "textBold",
        "textItalic",
        "textUnderline",
        "textAlignLeft"
      ]
    },
    "varve.node.move": {
      "status": "implemented",
      "gesture": ["drag-to-move"],
      "preconditions": [
        "the named nodes exist and none is locked",
        "mode 'to' accepts exactly one node"
      ],
      "tests": ["packages/automation/src/__tests__/executor.test.ts"],
      "limits": ["Align and distribute are not the same operation and are not covered by `by`."],
      "uiSurfaces": [
        "nudgeUp",
        "nudgeDown",
        "nudgeLeft",
        "nudgeRight",
        "alignLeft",
        "distributeHorizontal"
      ]
    },
    "varve.node.resize": {
      "status": "implemented",
      "gesture": ["drag-handle-resize"],
      "preconditions": ["the node kind has a direct size, and is not locked"],
      "tests": [
        "packages/automation/src/__tests__/executor.test.ts",
        "packages/scene/src/nodeResize.test.ts"
      ],
      "limits": ["Refuses kinds without a direct size instead of guessing one."],
      "uiSurfaces": ["resizeImage", "toolScale"]
    },
    "varve.node.delete": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["no named node is a page or master content root"],
      "tests": ["packages/automation/src/__tests__/live.test.ts"],
      "uiSurfaces": ["delete", "flattenSelection", "rasterizeSelection"]
    },
    "varve.node.reorder": {
      "status": "implemented",
      "gesture": ["layer-drag-reorder"],
      "preconditions": ["the node exists, is not locked, and has a parent"],
      "tests": ["packages/automation/src/__tests__/executor.test.ts"],
      "limits": ["Reports a no-op at the boundary rather than clamping."],
      "uiSurfaces": ["bringFront", "bringForward", "sendBackward", "sendBack"]
    },
    "varve.node.reparent": {
      "status": "implemented",
      "gesture": ["layer-drag-into-container"],
      "preconditions": [
        "target is a frame or group, or null for the document root",
        "no cycle is created"
      ],
      "tests": ["packages/automation/src/__tests__/executor.test.ts"],
      "limits": [
        "Group/ungroup are not the same operation; a dedicated group command does not exist yet."
      ],
      "uiSurfaces": ["group", "ungroup", "enterFrame"]
    },
    "varve.history.list": {
      "status": "implemented",
      "gesture": [],
      "preconditions": ["a document session is open"],
      "tests": ["packages/automation/src/__tests__/live.test.ts"],
      "uiSurfaces": ["toggleHistoryPanel", "restoreFromSnapshot"]
    },
    "varve.history.rollback": {
      "status": "implemented",
      "gesture": [],
      "preconditions": [
        "the transaction is still retained",
        "no later transaction changed the same entities"
      ],
      "tests": ["packages/automation/src/__tests__/live.test.ts"],
      "limits": [
        "Compensating and attributed: it reverts one named transaction and refuses on conflict. It never pops the last N edits.",
        "Undo/redo as a user presses them are a different mechanism (the editor's snapshot stack) and are not this command."
      ],
      "uiSurfaces": ["undo", "redo"]
    }
  },
